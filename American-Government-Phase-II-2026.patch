;border-left:4px solid #668bc5;background:#121d31;border-radius:9px}.source-box a{color:#a9caff;font-weight:850}.source-box p{margin:6px 0 0;color:#bdc8da;font-size:.88rem}.advance-note{display:block;margin-top:7px;font-size:.82rem;opacity:.84}.side-panel{color:var(--muted)}.side-panel ul{padding-left:22px}.side-panel li{margin:7px 0}.side-section{border-top:1px solid var(--line);padding-top:14px;margin-top:14px}.completion{margin-top:22px;padding:24px;text-align:center}.ticket-name{color:#fff;font-size:1.12rem}.hidden{display:none!important}@media(max-width:760px){.hero{grid-template-columns:1fr}.feature-pills{justify-content:flex-start}.fields,.workspace{grid-template-columns:1fr}.workspace{margin-top:20px}.side-panel{order:2}.shell{width:min(100% - 18px,980px);padding-top:12px}.hero,.student-panel{padding:19px}}@media(max-width:430px){.stats{gap:6px}.stats div{padding:8px}.feature-pills span{font-size:.7rem}.choice{padding:11px}}

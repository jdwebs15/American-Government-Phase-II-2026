-const QUESTIONS=[{"id":"q01","cs":"CS 8 • Purpose","topic":"CS 8 • Purpose","prompt":"Why was the Bill of Rights added to the Constitution?","choices":["to protect civil liberties and limit federal power","to eliminate state governments","to expand presidential terms","to replace the original Constitution within the government system described"],"answer":0,"hint":"Think protection plus limitation.","explanation":"The Bill of Rights protects individual liberties by placing limits on federal power."},{"id":"q02","cs":"CS 8 • Purpose","topic":"CS 8 • Purpose","prompt":"Which statement best describes a civil liberty?","choices":["a benefit supplied by private business under the constitutional process in the question","a freedom protected from improper government interference","a power belonging only to Congress","a responsibility to serve in office"],"answer":1,"hint":"Focus on freedom from government intrusion.","explanation":"Civil liberties are protected individual freedoms."},{"id":"q03","cs":"First Amendment • Speech","topic":"First Amendment • Speech","prompt":"A student peacefully criticizes a federal policy in a public speech. Which protection is most directly involved?","choices":["right to counsel","protection from double jeopardy","freedom of speech","reserved powers"],"answer":2,"hint":"The student is expressing an opinion.","explanation":"The First Amendment protects speech, including criticism of government."},{"id":"q04","cs":"First Amendment • Press","topic":"First Amendment • Press","prompt":"Federal officials try to stop a newspaper from publishing criticism merely because it is embarrassing. Which freedom is most directly involved?","choices":["right to bear arms","right to an impartial jury","protection from self-incrimination","freedom of the press"],"answer":3,"hint":"Think publication and journalism.","explanation":"Freedom of the press protects news organizations from improper government censorship."},{"id":"q05","cs":"First Amendment • Assembly","topic":"First Amendment • Assembly","prompt":"Residents gather peacefully at a courthouse to protest a law. Which freedom are they exercising?","choices":["freedom of assembly","freedom from search","right to counsel","reserved powers"],"answer":0,"hint":"They are gathering peacefully.","explanation":"The First Amendment protects peaceful assembly."},{"id":"q06","cs":"First Amendment • Petition","topic":"First Amendment • Petition","prompt":"Residents send signed requests asking Congress to change a law. Which freedom is illustrated?","choices":["freedom of the press","right to petition","right to a speedy trial","right to bear arms"],"answer":1,"hint":"They are asking government for change.","explanation":"The petition right lets people seek redress from government."},{"id":"q07","cs":"First Amendment • Religion","topic":"First Amendment • Religion","prompt":"Congress creates an official national church. Which protection is most directly violated?","choices":["the confrontation right","the Double Jeopardy Clause","the Establishment Clause","the Tenth Amendment"],"answer":2,"hint":"Government may not establish religion.","explanation":"The First Amendment bars government establishment of religion."},{"id":"q08","cs":"First Amendment • Religion","topic":"First Amendment • Religion","prompt":"A federal rule targets a particular faith and bans its worship services. Which protection is most directly involved?","choices":["freedom of the press","right to an impartial jury","protection from excessive fines","free exercise of religion"],"answer":3,"hint":"The rule blocks religious practice.","explanation":"The Free Exercise Clause protects religious practice from improper government restriction."},{"id":"q09","cs":"First Amendment • Identification","topic":"First Amendment • Identification","prompt":"Which list contains all five First Amendment freedoms emphasized in CS 8?","choices":["religion, speech, press, assembly, and petition","speech, voting, arms, privacy, and counsel","religion, jury, property, voting, and arms","press, warrants, taxes, trials, and states"],"answer":0,"hint":"Use the five freedoms in the amendment text.","explanation":"The First Amendment protects religion, speech, press, assembly, and petition."},{"id":"q10","cs":"Second Amendment","topic":"Second Amendment","prompt":"Which amendment protects the right to keep and bear arms?","choices":["Fourth Amendment","Second Amendment","Sixth Amendment","Tenth Amendment"],"answer":1,"hint":"The number is 2.","explanation":"The Second Amendment protects the right to keep and bear arms."},{"id":"q11","cs":"Second Amendment","topic":"Second Amendment","prompt":"A law directly prohibits every law-abiding citizen from possessing any firearm. Which amendment would be central to a constitutional challenge?","choices":["First Amendment","Fifth Amendment","Second Amendment","Eighth Amendment"],"answer":2,"hint":"The scenario concerns arms.","explanation":"The Second Amendment is the relevant Bill of Rights protection."},{"id":"q12","cs":"Fourth Amendment • Search","topic":"Fourth Amendment • Search","prompt":"Officers enter a home without consent, a warrant, probable cause, or an emergency. Which protection is most directly involved?","choices":["protection against double jeopardy","right to counsel","freedom of assembly","protection against unreasonable searches"],"answer":3,"hint":"The key words are officers and home search.","explanation":"The Fourth Amendment protects against unreasonable government searches."},{"id":"q13","cs":"Fourth Amendment • Warrant","topic":"Fourth Amendment • Warrant","prompt":"What must normally support a search warrant?","choices":["probable cause","a unanimous vote of Congress","permission from the press","a presidential pardon"],"answer":0,"hint":"The Fourth Amendment requires reasonable grounds.","explanation":"A warrant must be supported by probable cause."},{"id":"q14","cs":"Fourth Amendment • Warrant","topic":"Fourth Amendment • Warrant","prompt":"A warrant says only “search anywhere and take anything.” What requirement is missing?","choices":["approval from a jury","a particular description of the place and items or persons","a promise of a speedy trial under the constitutional process in the question","ratification by the states"],"answer":1,"hint":"Warrants must be specific.","explanation":"The Fourth Amendment requires particularity about where to search and what to seize."},{"id":"q15","cs":"Fourth Amendment • Seizure","topic":"Fourth Amendment • Seizure","prompt":"Police take a person’s phone without adequate legal justification. Which concept is most directly involved?","choices":["double jeopardy","free exercise","unreasonable seizure","reserved power"],"answer":2,"hint":"Government has taken property.","explanation":"The Fourth Amendment protects against unreasonable seizures as well as searches."},{"id":"q16","cs":"Fifth Amendment • Self-incrimination","topic":"Fifth Amendment • Self-incrimination","prompt":"An investigator forces a suspect to give testimonial answers admitting guilt. Which protection is implicated?","choices":["freedom of assembly","right to bear arms","reserved powers","protection against self-incrimination"],"answer":3,"hint":"Think “witness against himself.”","explanation":"The Fifth Amendment protects against compelled self-incrimination."},{"id":"q17","cs":"Fifth Amendment • Double jeopardy","topic":"Fifth Amendment • Double jeopardy","prompt":"After a defendant is acquitted, the government tries the person again for the identical offense. Which protection applies?","choices":["protection against double jeopardy","freedom of petition","right to a public trial only","Tenth Amendment reserved powers"],"answer":0,"hint":"Same offense, second trial.","explanation":"The Fifth Amendment protects against being placed in jeopardy twice for the same offense."},{"id":"q18","cs":"Fifth Amendment • Due process","topic":"Fifth Amendment • Due process","prompt":"A federal agency takes a person’s property without notice or a fair hearing. Which protection is most directly involved?","choices":["freedom of the press","due process of law","right to bear arms","freedom of assembly"],"answer":1,"hint":"The government skipped fair procedures.","explanation":"The Fifth Amendment requires due process before federal deprivation of life, liberty, or property."},{"id":"q19","cs":"Fifth Amendment • Comparison","topic":"Fifth Amendment • Comparison","prompt":"Which pairing is correct?","choices":["double jeopardy—delay before trial","due process—right to publish news","self-incrimination—forced testimony against oneself","probable cause—right to a lawyer"],"answer":2,"hint":"Match each term to its actual protection.","explanation":"Self-incrimination concerns compelled testimonial evidence against oneself."},{"id":"q20","cs":"Sixth Amendment • Speedy trial","topic":"Sixth Amendment • Speedy trial","prompt":"An accused person waits many years for trial because prosecutors repeatedly delay without justification. Which right is threatened?","choices":["right to petition when applied through ordinary legal procedures","freedom of religion","protection from search","right to a speedy trial"],"answer":3,"hint":"Focus on the delay.","explanation":"The Sixth Amendment protects against unreasonable delay in criminal prosecution."},{"id":"q21","cs":"Sixth Amendment • Public trial","topic":"Sixth Amendment • Public trial","prompt":"A criminal trial is secretly closed without a valid legal reason. Which right is most directly involved?","choices":["right to a public trial","right to bear arms","freedom of the press only","reserved state powers"],"answer":0,"hint":"The trial’s openness is the issue.","explanation":"The Sixth Amendment generally guarantees a public criminal trial."},{"id":"q22","cs":"Sixth Amendment • Jury","topic":"Sixth Amendment • Jury","prompt":"Jurors state before trial that they have already decided the defendant is guilty. Which right is threatened?","choices":["right to petition","right to an impartial jury","protection from double jeopardy under the constitutional process in the question","Tenth Amendment"],"answer":1,"hint":"Impartial means fair and unbiased.","explanation":"The Sixth Amendment guarantees an impartial jury."},{"id":"q23","cs":"Sixth Amendment • Charges","topic":"Sixth Amendment • Charges","prompt":"A defendant is jailed but is never told what crime is alleged. Which right is violated?","choices":["freedom of assembly","protection from seizure","right to be informed of the charges","right to bear arms as an action taken by public officials"],"answer":2,"hint":"A person must know the accusation.","explanation":"The Sixth Amendment requires notice of the nature and cause of the accusation."},{"id":"q24","cs":"Sixth Amendment • Confrontation","topic":"Sixth Amendment • Confrontation","prompt":"The prosecution uses an accusing witness, but the defendant is given no opportunity to challenge that witness. Which right is involved?","choices":["right to petition","free exercise of religion when applied through ordinary legal procedures","reserved powers","right to confront one’s accusers"],"answer":3,"hint":"Think cross-examination.","explanation":"The Sixth Amendment protects confrontation of adverse witnesses."},{"id":"q25","cs":"Sixth Amendment • Counsel","topic":"Sixth Amendment • Counsel","prompt":"A person facing a serious criminal charge is denied access to a defense attorney. Which right is implicated?","choices":["right to counsel","freedom of the press","protection from excessive bail only","right to petition"],"answer":0,"hint":"Counsel means lawyer.","explanation":"The Sixth Amendment protects assistance of counsel for the defense."},{"id":"q26","cs":"Sixth Amendment • Identification","topic":"Sixth Amendment • Identification","prompt":"Which amendment contains the rights to a speedy public trial, an impartial jury, notice, confrontation, and counsel?","choices":["First Amendment",
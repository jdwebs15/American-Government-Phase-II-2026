-const QUESTIONS=[{"id":"q01","cs":"CS 12 • Foundations","topic":"CS 12 • Foundations","prompt":"Which definition best matches law?","choices":["a binding rule recognized and enforced by government","a personal preference with no government effect within the government system described","a power belonging only to local governments","a procedure used only during elections"],"answer":0,"hint":"Think enforceable rule.","explanation":"Laws are binding rules enforced by government."},{"id":"q02","cs":"CS 12 • Foundations","topic":"CS 12 • Foundations","prompt":"Which definition best matches public policy?","choices":["a personal preference with no government effect under the constitutional process in the question","government actions and procedures used to carry out public functions","a power belonging only to local governments","a procedure used only during elections"],"answer":1,"hint":"Think what government chooses to do.","explanation":"Public policy consists of institutional actions and procedures."},{"id":"q03","cs":"CS 12 • Legislative","topic":"CS 12 • Legislative","prompt":"Which definition best matches legislative branch?","choices":["a personal preference with no government effect as an action taken by public officials","a power belonging only to local governments","the branch that makes laws declares war and imposes taxes","a procedure used only during elections"],"answer":2,"hint":"Think Congress.","explanation":"Congress performs the legislative functions identified in CS 12."},{"id":"q04","cs":"CS 12 • Legislative","topic":"CS 12 • Legislative","prompt":"Which definition best matches legislation?","choices":["a personal preference with no government effect when applied through ordinary legal procedures","a power belonging only to local governments","a procedure used only during elections","a bill or law created through the legislative process"],"answer":3,"hint":"Think lawmaking.","explanation":"Legislation is a principal tool Congress uses to create public policy."},{"id":"q05","cs":"CS 12 • Legislative","topic":"CS 12 • Legislative","prompt":"Which definition best matches declaration of war?","choices":["a formal legislative decision placing the nation in a state of war","a personal preference with no government effect within the government system described","a power belonging only to local governments","a procedure used only during elections"],"answer":0,"hint":"Congress holds this power.","explanation":"Declaring war is a legislative responsibility."},{"id":"q06","cs":"CS 12 • Legislative","topic":"CS 12 • Legislative","prompt":"Which definition best matches taxation?","choices":["a personal preference with no government effect","the government collection of revenue through taxes","a power belonging only to local governments","a procedure used only during elections"],"answer":1,"hint":"Congress imposes taxes.","explanation":"Taxation funds government operations and policies."},{"id":"q07","cs":"CS 12 • Executive","topic":"CS 12 • Executive","prompt":"Which definition best matches executive branch?","choices":["a personal preference with no government effect as an action taken by public officials","a power belonging only to local governments","the branch that enforces laws issues executive orders and handles ambassadors","a procedure used only during elections"],"answer":2,"hint":"Think President.","explanation":"The executive carries out law and administers policy."},{"id":"q08","cs":"CS 12 • Executive","topic":"CS 12 • Executive","prompt":"Which definition best matches executive order?","choices":["a personal preference with no government effect when applied through ordinary legal procedures","a power belonging only to local governments","a procedure used only during elections","a directive issued by the president to manage executive operations"],"answer":3,"hint":"It comes from the executive.","explanation":"Executive orders direct the work of the executive branch."},{"id":"q09","cs":"CS 12 • Executive","topic":"CS 12 • Executive","prompt":"Which definition best matches ambassador?","choices":["an official representative of one country to another","a personal preference with no government effect within the government system described","a power belonging only to local governments","a procedure used only during elections"],"answer":0,"hint":"Think diplomacy.","explanation":"The executive appoints and receives ambassadors."},{"id":"q10","cs":"CS 12 • Judicial","topic":"CS 12 • Judicial","prompt":"Which definition best matches judicial branch?","choices":["a personal preference with no government effect under the constitutional process in the question","the branch that interprets law and hears original and appellate cases","a power belonging only to local governments","a procedure used only during elections"],"answer":1,"hint":"Think federal courts.","explanation":"The judiciary resolves cases and interprets laws."},{"id":"q11","cs":"CS 12 • Judicial","topic":"CS 12 • Judicial","prompt":"Which definition best matches original jurisdiction?","choices":["a personal preference with no government effect","a power belonging only to local governments","authority to hear a case first","a procedure used only during elections"],"answer":2,"hint":"Original means first.","explanation":"A court with original jurisdiction begins the case."},{"id":"q12","cs":"CS 12 • Judicial","topic":"CS 12 • Judicial","prompt":"Which definition best matches appellate jurisdiction?","choices":["a personal preference with no government effect","a power belonging only to local governments","a procedure used only during elections","authority to review decisions from lower courts"],"answer":3,"hint":"Think appeal.","explanation":"Appellate courts review lower-court decisions."},{"id":"q13","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches veto?","choices":["a presidential rejection of legislation","a personal preference with no government effect","a power belonging only to local governments","a procedure used only during elections"],"answer":0,"hint":"Executive check on Congress.","explanation":"The veto lets the executive check the legislative branch."},{"id":"q14","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches veto override?","choices":["a personal preference with no government effect under the constitutional process in the question","Congress passing a vetoed bill with the required supermajority","a power belonging only to local governments","a procedure used only during elections"],"answer":1,"hint":"Congress responds to a veto.","explanation":"An override is a legislative check on the executive."},{"id":"q15","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches impeachment?","choices":["a personal preference with no government effect as an action taken by public officials","a power belonging only to local governments","the formal accusation of a civil officer by the House","a procedure used only during elections"],"answer":2,"hint":"Accusation is not removal.","explanation":"The House impeaches; the Senate conducts the trial."},{"id":"q16","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches removal from office?","choices":["a personal preference with no government effect when applied through ordinary legal procedures","a power belonging only to local governments","a procedure used only during elections","the Senate consequence following conviction in an impeachment trial"],"answer":3,"hint":"Think conviction after impeachment.","explanation":"The Senate may remove an impeached officer after conviction."},{"id":"q17","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches advice and consent?","choices":["the Senate role in approving appointments and treaties","a personal preference with no government effect within the government system described","a power belonging only to local governments","a procedure used only during elections"],"answer":0,"hint":"Think Senate approval.","explanation":"Senate approval checks executive appointment and treaty powers."},{"id":"q18","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches judicial nomination?","choices":["a personal preference with no government effect under the constitutional process in the question","the president selecting a person for a federal judgeship","a power belonging only to local governments","a procedure used only during elections"],"answer":1,"hint":"Executive checks judiciary through selection.","explanation":"The president nominates federal judges, subject to Senate confirmation."},{"id":"q19","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches pardon?","choices":["a personal preference with no government effect","a power belonging only to local governments","executive forgiveness of a federal offense","a procedure used only during elections"],"answer":2,"hint":"Presidential clemency.","explanation":"Pardons are an executive check related to judicial outcomes."},{"id":"q20","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches reprieve?","choices":["a personal preference with no government effect","a power belonging only to local governments","a procedure used only during elections","a temporary delay of punishment"],"answer":3,"hint":"It postpones rather than forgives.","explanation":"A reprieve temporarily delays a sentence."},{"id":"q21","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches judicial review?","choices":["court authority to evaluate laws or executive acts for constitutionality","a personal preference with no government effect within the government system described","a power belonging only to local governments","a procedure used only during elections"],"answer":0,"hint":"Think unconstitutional acts.","explanation":"Judicial review checks both legislative and executive action."},{"id":"q22","cs":"CS 13 • Checks","topic":"CS 13 • Checks","prompt":"Which definition best matches constitutional amendment proposal?","choices":["a personal preference with no government effect under the constitutional process in the question","a congressional method for responding to constitutional interpretation","a power belonging only to local governments","a procedure used only during elections"],"answer":1,"hint":"Congress may propose a change to the Constitution.","explanation":"Proposing amendments is a legislative check involving the constitutional framework."},{"id":"q23","cs":"CS 13 • Dynamics","topic":"CS 13 • Dynamics","prompt":"Which definition best matches interest group?","choices":["a personal preference with no government effect as an action taken by public officials","a power belonging only to local governments","an organized group seeking to influence public policy","a procedure used only during elections"],"answer":2,"hint":"Think advocacy.","explanation":"Interest groups propose legislation, advocate rules, and file briefs."},{"id":"q24","cs":"CS 13 • Dynamics","topic":"CS 13 • Dynamics","prompt":"Which definition best matches amicus brief?","choices":["a personal preference with no government effect when applied through ordinary legal procedures","a power belonging only to local governments","a procedure used only during elections","a filing by a nonparty offering information or arguments to a court"],"answer":3,"hint":"Interest groups may file these.","explanation":"Amicus briefs are one way organized groups influence judicial consideration."},{"id":"q25","cs":"CS 13 • Dynamics","topic":"CS 13 • Dynamics","prompt":"Which definition best matches divided government?","choices":["different political parties controlling the executive and legislative branches","a personal preference with no government effect within the government system described","a power belonging only to local governments","a procedure used only during elections"],"answer":0,"hint":"Think party control split across branches.","explanation":"Divided government can increase conflict or negotiation."},{"id":"q26","cs":"CS 13 • Dynamics","topic":"CS 13 • Dynamics","prompt":"Which definition best matches public interest?","choices":["a personal preference with no government effect under the constitutional process in the question","the level of attention citizens give a current issue","a power belonging only to local governments","a procedure used only during elections"],"answer":1,"hint":"Public attention can affect branch behavior.","explanation":"High public interest can increase political pressure."},{"id":"q27","cs":"CS 13 • Dynamics","topic":"CS 13 • Dynamics","prompt":"Which definition best matches media coverage?","choices":["a personal preference with no government effect as an action taken by public officials","a power belonging only to local governments","reporting and commentary that shape public attention to issues","a procedure used only during elections"],"answer":2,"hint":"Think news and commentary.","explanation":"Media coverage can influence the environment in which branches act."},{"id":"q28","cs":"CS 13 • Dynamics","topic":"CS 13 • Dynamics","prompt":"Which definition best matches informal relationships?","choices":["a personal preference with no government effect when applied through ordinary legal procedures","a power belonging only to local governments","a procedure used only during elections","personal and working connections among members of different branches"],"answer":3,"hint":"Not every interaction is written in the Constitution.","explanation":"Informal relationships can support cooperation or intensify conflict."},{"id":"test-language-1","cs":"State Test Language","topic":"State Test Language","prompt":"What does implement mean in a public-policy question?","choices":["put a law or policy into effect","declare a policy unconstitutional automatically","write a private opinion a
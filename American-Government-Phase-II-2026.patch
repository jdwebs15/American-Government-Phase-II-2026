-const QUESTIONS=[{"id":"q01","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches Bill of Rights?","choices":["the first ten amendments protecting liberties and limiting federal power","a power held only by Congress within the government system described","a procedure for amending the Constitution","a rule for electing the president"],"answer":0,"hint":"Think Amendments 1–10.","explanation":"The Bill of Rights lists important protections against government action."},{"id":"q02","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches civil liberties?","choices":["a power held only by Congress","fundamental freedoms protected from government interference","a procedure for amending the Constitution","a rule for electing the president"],"answer":1,"hint":"Think protected freedom.","explanation":"Civil liberties limit government interference with individual freedom."},{"id":"q03","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches freedom of speech?","choices":["the right to own any property","the right to avoid every law","the right to express ideas and opinions","the right to vote in every election"],"answer":2,"hint":"Think expression.","explanation":"The First Amendment protects speech from improper government restriction."},{"id":"q04","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches freedom of religion?","choices":["a guarantee that government funds every religion when applied through ordinary legal procedures","a ban on private religious practice","a right to ignore neutral laws","protection for religious belief and practice and against government establishment"],"answer":3,"hint":"Think establishment and free exercise.","explanation":"The First Amendment contains both religion clauses."},{"id":"q05","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches establishment clause?","choices":["the First Amendment rule against government establishment of religion","a power held only by Congress within the government system described","a procedure for amending the Constitution","a rule for electing the president"],"answer":0,"hint":"Government may not establish an official religion.","explanation":"The Establishment Clause limits government sponsorship of religion."},{"id":"q06","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches free exercise clause?","choices":["a power held only by Congress under the constitutional process in the question","the First Amendment protection for practicing religion","a procedure for amending the Constitution","a rule for electing the president"],"answer":1,"hint":"Think freedom to exercise belief.","explanation":"The Free Exercise Clause protects religious practice, subject to lawful limits."},{"id":"q07","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches freedom of the press?","choices":["a power held only by Congress as an action taken by public officials","a procedure for amending the Constitution","the right to publish news and opinions without improper government censorship","a rule for electing the president"],"answer":2,"hint":"Think newspapers and journalists.","explanation":"The First Amendment protects press freedom."},{"id":"q08","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches freedom of assembly?","choices":["a power held only by Congress when applied through ordinary legal procedures","a procedure for amending the Constitution","a rule for electing the president","the right to gather peacefully for a common purpose"],"answer":3,"hint":"Think peaceful gathering.","explanation":"The First Amendment protects peaceful assembly."},{"id":"q09","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches right to petition?","choices":["the right to ask government to correct a problem or change policy","a power held only by Congress within the government system described within the government system described","a procedure for amending the Constitution","a rule for electing the president"],"answer":0,"hint":"Think requests to government.","explanation":"Petition allows people to seek a redress of grievances."},{"id":"q10","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches right to bear arms?","choices":["a power held only by Congress under the constitutional process in the question","the Second Amendment protection involving keeping and carrying arms","a procedure for amending the Constitution","a rule for electing the president"],"answer":1,"hint":"Think Amendment 2.","explanation":"The Second Amendment protects the right to keep and bear arms."},{"id":"q11","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches unreasonable search and seizure?","choices":["a power held only by Congress as an action taken by public officials","a procedure for amending the Constitution","a government search or taking that lacks adequate legal justification","a rule for electing the president"],"answer":2,"hint":"Think privacy and police searches.","explanation":"The Fourth Amendment bars unreasonable searches and seizures."},{"id":"q12","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches search warrant?","choices":["a power held only by Congress when applied through ordinary legal procedures","a procedure for amending the Constitution","a rule for electing the president","a court order authorizing a particular search"],"answer":3,"hint":"A judge issues it.","explanation":"A warrant must rest on probable cause and describe the search."},{"id":"q13","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches probable cause?","choices":["reasonable grounds supporting a search, arrest, or warrant","a power held only by Congress within the government system described","a procedure for amending the Constitution","a rule for electing the president"],"answer":0,"hint":"More than a mere guess.","explanation":"The Fourth Amendment requires probable cause for warrants."},{"id":"q14","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches self-incrimination?","choices":["a power held only by Congress under the constitutional process in the question","giving testimony or evidence that could expose oneself to criminal guilt","a procedure for amending the Constitution","a rule for electing the president"],"answer":1,"hint":"Think being a witness against yourself.","explanation":"The Fifth Amendment protects against compelled self-incrimination."},{"id":"q15","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches double jeopardy?","choices":["a power held only by Congress as an action taken by public officials","a procedure for amending the Constitution","being tried twice for the same offense after jeopardy has ended","a rule for electing the president"],"answer":2,"hint":"Same offense, second prosecution.","explanation":"The Fifth Amendment protects against double jeopardy."},{"id":"q16","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches due process?","choices":["a power held only by Congress when applied through ordinary legal procedures","a procedure for amending the Constitution","a rule for electing the president","fair legal procedures before government deprives life liberty or property"],"answer":3,"hint":"Think fair process.","explanation":"The Fifth Amendment guarantees due process by the federal government."},{"id":"q17","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches speedy trial?","choices":["a criminal trial without unreasonable government delay","a power held only by Congress within the government system described","a procedure for amending the Constitution","a rule for electing the president"],"answer":0,"hint":"Delay is the clue.","explanation":"The Sixth Amendment protects a speedy trial."},{"id":"q18","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches public trial?","choices":["a power held only by Congress under the constitutional process in the question","a criminal trial generally open to public observation","a procedure for amending the Constitution","a rule for electing the president"],"answer":1,"hint":"Think openness.","explanation":"The Sixth Amendment protects a public trial."},{"id":"q19","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches impartial jury?","choices":["a power held only by Congress","a procedure for amending the Constitution","jurors who are fair and unbiased","a rule for electing the president"],"answer":2,"hint":"Impartial means unbiased.","explanation":"The Sixth Amendment requires an impartial jury."},{"id":"q20","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches notice of charges?","choices":["a power held only by Congress when applied through ordinary legal procedures","a procedure for amending the Constitution","a rule for electing the president","the right of an accused person to know the accusation"],"answer":3,"hint":"A defendant must know what to defend against.","explanation":"The Sixth Amendment requires information about the charges."},{"id":"q21","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches confrontation right?","choices":["the right to face and challenge opposing witnesses","a power held only by Congress within the government system described","a procedure for amending the Constitution","a rule for electing the president"],"answer":0,"hint":"Think cross-examining an accuser.","explanation":"The Sixth Amendment protects confrontation of witnesses."},{"id":"q22","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches right to counsel?","choices":["a power held only by Congress under the constitutional process in the question","the right to assistance from a lawyer in a criminal defense","a procedure for amending the Constitution","a rule for electing the president"],"answer":1,"hint":"Counsel means attorney.","explanation":"The Sixth Amendment protects legal assistance for the accused."},{"id":"q23","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches cruel and unusual punishment?","choices":["a power held only by Congress as an action taken by public officials","a procedure for amending the Constitution","punishment forbidden by the Eighth Amendment because of its unconstitutional severity or character","a rule for electing the president"],"answer":2,"hint":"Think Amendment 8.","explanation":"The Eighth Amendment prohibits cruel and unusual punishment."},{"id":"q24","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches delegated powers?","choices":["a power held only by Congress when applied through ordinary legal procedures","a procedure for amending the Constitution","a rule for electing the president","powers granted to the federal government by the Constitution"],"answer":3,"hint":"Delegated means given.","explanation":"The Constitution delegates specified powers to the federal government."},{"id":"q25","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches reserved powers?","choices":["undelegated powers kept by the states or the people","powers held only by federal courts within the government system described","powers created by executive order","powers denied to every government"],"answer":0,"hint":"Think Tenth Amendment.","explanation":"The Tenth Amendment reserves undelegated powers to states or the people."},{"id":"q26","cs":"CS 8 • Bill of Rights","topic":"CS 8 • Bill of Rights","prompt":"Which definition best matches Tenth Amendment?","choices":["a power held only by Congress under the constitutional process in the question","the amendment reserving undelegated powers to states or the people","a procedure for amending the Constitution","a rule for electing the president"],"answer":1,"hint":"Think federalism.","explanation":"The Tenth Amendment reinforces the constitutional division of power."},{"id":"test-language-1","cs":"State Test Language","topic":"State Test Language","prompt":"In a Bill of Rights question, what does unreasonable mean?","choices":["required in every criminal case as an action taken by public officials","approved by all state legislatures","not supported by adequate legal justification or sensible limits","identical to a constitutional amendment"],"answer":2,"hint":"Think about a search that lacks a sound legal reason.","explanation":"Unreasonable means lacking adequate justification or exceeding sensible limits."},{"id":"test-language-2","cs":"State Test Language","topic":"State Test Language","prompt":"If government compels a person to testify, what does compels mean?","choices":["invites the person to volunteer","allows the person to postpone forever","asks the states to amend the Constitution","forces or requires the person to act"],"answer":3,"hint":"The person is not acting voluntarily.","explanation":"To compel is to force or legally require an action."},{"id":"test-language-3","cs":"State Test Language","topic":"State Test Language","prompt":"What does deprive mean in the phrase deprive a person of liberty?","choices":["take away or deny something the person possesses","describe a right in greater detail within the government system described","divide authority among branches","approve a request through an election"],"answer":0,"hint":"Think about losing a protected interest.","explanation":"To deprive is to take away or deny something."}];
